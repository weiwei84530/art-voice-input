<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The launcher's Info.plist. It is part of the launcher's ad hoc signature: never put the app's version here, or
     every update would change the signature and the permissions would have to be given again. -->
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>ArtVoiceInput</string>
    <key>CFBundleIdentifier</key>
    <string>com.artvoiceinput.app</string>
    <key>CFBundleName</key>
    <string>Art VoiceInput</string>
    <key>CFBundleDisplayName</key>
    <string>阿特語音輸入法</string>
    <key>CFBundleIconFile</key>
    <string>appicon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_TW</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>阿特語音輸入法需要麥克風來聽你說話，辨識全部在這台電腦上進行，聲音不會傳到網路。</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>阿特語音輸入法用它在錄音時暫時把電腦音效靜音。</string>
</dict>
</plist>
